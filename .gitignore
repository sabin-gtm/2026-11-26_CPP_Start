# Ignore generated files and directories in this repository

# (This is how you makes a gitignore file. You can specify files, directories, or patterns to ignore in your Git repository.)

# cache.txt        # Ignore one file
# *.log            # Ignore all .log files
# build/           # Ignore a folder
# **/temp/         # Ignore temp folders at any depth
# !important.txt   # Undo a previous ignore rule

# Compiled executables
*.exe
*.out
*.app

# Object files
*.o
*.obj

# IDE/build folders
.vs/
.vscode/
build/